generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile         Profile?
  salary          Salary?
  otherIncomes    OtherIncome[]
  stocks          Stock[]
  fixedDeposits   FixedDeposit[]
  mutualFunds     MutualFund[]
  mfTransactions  MfTransaction[]
  otherAssets     OtherAsset[]
  savingPots      SavingPot[]
  homeLoans       HomeLoan[]
  otherDebts      OtherDebt[]
  healthInsurance HealthInsurance[]
  expenses        MonthlyExpense[]
  expenseEntries  ExpenseEntry[]
  settings        UserSettings?
}

model Profile {
  id                  String  @id @default(uuid())
  userId              String  @unique
  name                String  @default("")
  age                 Int     @default(30)
  currency            String  @default("INR")
  retirementAge       Int     @default(60)
  onboardingComplete  Boolean @default(false)
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Salary {
  id              String @id @default(uuid())
  userId          String @unique
  monthlyGross    Float  @default(0)
  monthlyInHand   Float  @default(0)
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtherIncome {
  id        String @id @default(uuid())
  userId    String
  name      String
  amount    Float
  frequency String @default("monthly")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Stock {
  id           String  @id @default(uuid())
  userId       String
  name         String
  ticker       String?
  quantity     Float
  buyPrice     Float
  currentPrice Float
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FixedDeposit {
  id           String   @id @default(uuid())
  userId       String
  name         String
  principal    Float
  interestRate Float
  startDate    DateTime @db.Date
  maturityDate DateTime @db.Date
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MutualFund {
  id             String @id @default(uuid())
  userId         String
  name           String
  investedAmount Float
  currentValue   Float
  monthlySip     Float  @default(0)
  fundCategory   String @default("equity")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MfTransaction {
  id         String   @id @default(uuid())
  userId     String
  fundId     String
  tradeId    String?
  date       DateTime @db.Date
  type       String
  units      Float
  nav        Float
  amount     Float?
  sourceFile String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, fundId])
}

model OtherAsset {
  id           String @id @default(uuid())
  userId       String
  name         String
  kind         String @default("other")
  quantity     Float
  unit         String @default("g")
  buyPrice     Float
  currentPrice Float
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavingPot {
  id                     String    @id @default(uuid())
  userId                 String
  name                   String
  purpose                String
  vehicle                String
  targetAmount           Float
  targetDate             DateTime? @db.Date
  currentAmount          Float     @default(0)
  monthlyAmount          Float     @default(0)
  expectedReturnPercent  Float     @default(0)
  planMode               String    @default("accumulate")
  swpYears               Float?
  swpCorpus              Float?
  linkedFixedDepositId   String?
  linkedMutualFundId     String?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HomeLoan {
  id            String       @id @default(uuid())
  userId        String
  name          String
  marketValue   Float
  purchasePrice Float
  downPayment   Float
  loanAmount    Float
  startDate     DateTime     @db.Date
  interestRate  Float
  tenureMonths  Int
  emi           Float?
  amountPaid    Float?
  rateChanges   RateChange[]
  prepayments   Prepayment[]
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateChange {
  id            String   @id @default(uuid())
  homeLoanId    String
  date          DateTime @db.Date
  interestRate  Float
  homeLoan      HomeLoan @relation(fields: [homeLoanId], references: [id], onDelete: Cascade)

  @@index([homeLoanId])
}

model Prepayment {
  id         String    @id @default(uuid())
  homeLoanId String
  date       DateTime  @db.Date
  amount     Float
  frequency  String?
  endDate    DateTime? @db.Date
  homeLoan   HomeLoan  @relation(fields: [homeLoanId], references: [id], onDelete: Cascade)

  @@index([homeLoanId])
}

model OtherDebt {
  id              String @id @default(uuid())
  userId          String
  name            String
  principal       Float
  interestRate    Float
  emi             Float
  remainingMonths Int
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthInsurance {
  id            String   @id @default(uuid())
  userId        String
  provider      String
  type          String   @default("health")
  coverAmount   Float
  premium       Float
  frequency     String   @default("yearly")
  renewalDate   DateTime @db.Date
  peopleCovered Json     @default("[]")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MonthlyExpense {
  id       String @id @default(uuid())
  userId   String
  category String
  name     String
  amount   Float
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExpenseEntry {
  id       String   @id @default(uuid())
  userId   String
  category String
  name     String
  amount   Float
  date     DateTime @db.Date
  notes    String?
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model UserSettings {
  id            String    @id @default(uuid())
  userId        String    @unique
  theme         String    @default("system")
  autoPersist   Boolean   @default(true)
  lastBackupAt  DateTime?
  backupPending Boolean   @default(false)
  taxProfile    Json?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
